#!/bin/bash
set -euo pipefail

BUILD_ARTIFACTS=0
CREATE_ZIPS=0
CONFIGURATION=release
JOBS="$(sysctl -n hw.ncpu 2>/dev/null || echo 8)"
SDK_LOCK="${LIBGODOT_SDK_LOCK:-config/libgodot-sdk.json}"

usage() {
    cat <<EOF
usage: $0 [options] <SwiftGodot dir> <godot dir> <output dir>

Build and/or package libgodot artifacts into xcframeworks under:
    <output dir>/mac/libgodot.xcframework
    <output dir>/ios/libgodot.xcframework

Options:
    --build                  Build the Godot SCons artifacts before packaging.
    --configuration <mode>   release or debug. Defaults to release.
    --zip                    Also create SwiftPM payload zips and print checksums.
    --jobs <count>           SCons parallelism when using --build. Defaults to CPU count.
    -h, --help               Show this help.

Canonical release payload:
    $0 --build --configuration release --zip <SwiftGodot dir> <godot dir> <output dir>
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --build)
            BUILD_ARTIFACTS=1
            shift
            ;;
        --configuration)
            if [[ $# -lt 2 ]]; then
                echo "error: --configuration requires release or debug" >&2
                exit 1
            fi
            CONFIGURATION="$2"
            shift 2
            ;;
        --zip)
            CREATE_ZIPS=1
            shift
            ;;
        --jobs|-j)
            if [[ $# -lt 2 ]]; then
                echo "error: --jobs requires a count" >&2
                exit 1
            fi
            JOBS="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "error: unknown option: $1" >&2
            usage
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

if [[ $# -lt 3 ]]; then
    usage
    exit 1
fi

SWIFTGODOT_DIR="$(cd "$1" && pwd)"
GODOT_DIR="$(cd "$2" && pwd)"
mkdir -p "$3"
OUTPUT_DIR="$(cd "$3" && pwd)"

if [[ ! -f "$SWIFTGODOT_DIR/Package.swift" ]]; then
    echo "error: expected a SwiftGodot checkout at $SWIFTGODOT_DIR" >&2
    exit 1
fi

if [[ -f "$GODOT_DIR/include/libgodot.h" && -f "$GODOT_DIR/BUILD_INFO.json" ]]; then
    INPUT_KIND=sdk
elif [[ -f "$GODOT_DIR/core/extension/libgodot.h" ]]; then
    INPUT_KIND=source
else
    echo "error: expected a custom-Godot SDK or source tree at $GODOT_DIR" >&2
    exit 1
fi

if [[ "$BUILD_ARTIFACTS" == "1" && "$INPUT_KIND" == "sdk" ]]; then
    echo "error: --build requires a custom-Godot source tree, not a published SDK" >&2
    exit 1
fi

if [[ "$INPUT_KIND" == "sdk" ]]; then
    scripts/verify-custom-godot-sdk "$GODOT_DIR" "$SDK_LOCK"
fi

case "$CONFIGURATION" in
    release|debug)
        ;;
    *)
        echo "error: --configuration must be release or debug" >&2
        exit 1
        ;;
esac

MAC_ARM_RELEASE_LIB="$GODOT_DIR/bin/libgodot.macos.template_release.arm64.dylib"
MAC_X86_RELEASE_LIB="$GODOT_DIR/bin/libgodot.macos.template_release.x86_64.dylib"
MAC_ARM_DEBUG_LIB="$GODOT_DIR/bin/libgodot.macos.template_debug.arm64.dylib"
MAC_X86_DEBUG_LIB="$GODOT_DIR/bin/libgodot.macos.template_debug.x86_64.dylib"
IOS_ARM_RELEASE_LIB="$GODOT_DIR/bin/libgodot.ios.template_release.arm64.a"
IOS_ARM_SIM_RELEASE_LIB="$GODOT_DIR/bin/libgodot.ios.template_release.arm64.simulator.a"
IOS_X86_SIM_RELEASE_LIB="$GODOT_DIR/bin/libgodot.ios.template_release.x86_64.simulator.a"
IOS_ARM_DEBUG_LIB="$GODOT_DIR/bin/libgodot.ios.template_debug.arm64.a"
IOS_ARM_SIM_DEBUG_LIB="$GODOT_DIR/bin/libgodot.ios.template_debug.arm64.simulator.a"
IOS_X86_SIM_DEBUG_LIB="$GODOT_DIR/bin/libgodot.ios.template_debug.x86_64.simulator.a"

run_scons() {
    (
        cd "$GODOT_DIR"
        scons "$@" accesskit=no angle=no "-j$JOBS"
    )
}

build_godot_artifacts() {
    local target="template_$CONFIGURATION"

    echo "Building macOS libgodot ($CONFIGURATION)..."
    run_scons platform=macos arch=arm64 target="$target" library_type=shared_library vulkan=no metal=yes disable_path_overrides=no
    run_scons platform=macos arch=x86_64 target="$target" library_type=shared_library vulkan=no metal=yes disable_path_overrides=no

    echo "Building iOS libgodot ($CONFIGURATION)..."
    run_scons platform=ios arch=arm64 ios_simulator=no target="$target" library_type=static_library vulkan=no metal=yes disable_path_overrides=no
    run_scons platform=ios arch=arm64 ios_simulator=yes target="$target" library_type=static_library vulkan=no metal=yes disable_path_overrides=no
}

select_artifacts() {
    if [[ "$CONFIGURATION" == "release" ]]; then
        MAC_ARM_LIB="$MAC_ARM_RELEASE_LIB"
        MAC_X86_LIB="$MAC_X86_RELEASE_LIB"
        IOS_DEVICE_LIB="$IOS_ARM_RELEASE_LIB"
        IOS_SIM_ARM_LIB="$IOS_ARM_SIM_RELEASE_LIB"
        IOS_SIM_X86_LIB="$IOS_X86_SIM_RELEASE_LIB"
    else
        MAC_ARM_LIB="$MAC_ARM_DEBUG_LIB"
        MAC_X86_LIB="$MAC_X86_DEBUG_LIB"
        IOS_DEVICE_LIB="$IOS_ARM_DEBUG_LIB"
        IOS_SIM_ARM_LIB="$IOS_ARM_SIM_DEBUG_LIB"
        IOS_SIM_X86_LIB="$IOS_X86_SIM_DEBUG_LIB"
    fi
}

verify_exact_architectures() {
    local binary="$1"
    shift
    local actual
    local expected

    actual=$(lipo -archs "$binary") || {
        echo "error: could not inspect architectures in $binary" >&2
        exit 1
    }
    actual=$(tr ' ' '\n' <<<"$actual" | sed '/^$/d' | sort | tr '\n' ' ' | sed 's/ $//')
    expected=$(printf '%s\n' "$@" | sort | tr '\n' ' ' | sed 's/ $//')
    if [[ "$actual" != "$expected" ]]; then
        echo "error: $binary has architectures [$actual], expected exactly [$expected]" >&2
        exit 1
    fi
}

verify_embeddable_ios_archive() {
    local archive="$1"
    local expected_arch="$2"
    local symbols
    local members

    if ! symbols="$(nm -gjU "$archive" 2>/dev/null)"; then
        echo "error: could not inspect symbols in $archive" >&2
        exit 1
    fi

    if grep -qx _main <<<"$symbols"; then
        echo "error: $archive exports _main and cannot be embedded in an app" >&2
        exit 1
    fi

    for symbol in \
        _libgodot_create_godot_instance \
        _libgodot_destroy_godot_instance \
        _libgodot_ios_create_rendering_layer \
        _libgodot_ios_initialize_rendering_layer \
        _libgodot_ios_layout_rendering_layer \
        _libgodot_ios_start_rendering_layer \
        _libgodot_ios_stop_rendering_layer
    do
        if ! grep -qx "$symbol" <<<"$symbols"; then
            echo "error: $archive is missing $symbol" >&2
            exit 1
        fi
    done

    if ! members="$(ar -t "$archive")"; then
        echo "error: could not inspect archive members in $archive" >&2
        exit 1
    fi

    if grep -Eq '(^|/)app\..*\.o$' <<<"$members"; then
        echo "error: $archive contains the standalone app object" >&2
        exit 1
    fi

    verify_exact_architectures "$archive" "$expected_arch"
}

verify_macos_dylib() {
    local dylib="$1"
    local expected_arch="$2"
    local symbols

    symbols=$(nm -gjU "$dylib" 2>/dev/null) || {
        echo "error: could not inspect symbols in $dylib" >&2
        exit 1
    }
    for symbol in _libgodot_create_godot_instance _libgodot_destroy_godot_instance; do
        if ! grep -qx "$symbol" <<<"$symbols"; then
            echo "error: $dylib is missing $symbol" >&2
            exit 1
        fi
    done
    if grep -qx _main <<<"$symbols"; then
        echo "error: $dylib exports _main and cannot be embedded in an app" >&2
        exit 1
    fi

    verify_exact_architectures "$dylib" "$expected_arch"
}

verify_headerless_xcframework() {
    local framework="$1"

    # SwiftGodotKit exposes its namespaced C declarations through the separate
    # libgodot system-library target. Shipping Godot's own libgodot.h in this
    # binary target makes Xcode flatten it into the shared product include
    # directory, where GDExtensionC's umbrella module imports it by accident.
    if find "$framework" -type d -name Headers -print -quit | grep -q .; then
        echo "error: $framework must not contain headers" >&2
        exit 1
    fi
}

replace_framework() {
    local staged="$1"
    local destination="$2"
    local backup=""

    if [[ -e "$destination" ]]; then
        backup="$destination.backup.$$"
        mv "$destination" "$backup"
    fi
    if ! mv "$staged" "$destination"; then
        if [[ -n "$backup" ]]; then
            mv "$backup" "$destination"
        fi
        return 1
    fi
    if [[ -n "$backup" ]]; then
        rm -rf "$backup"
    fi
}

zip_payloads() {
    local mac_zip="$OUTPUT_DIR/mac/libgodot-macos.xcframework.zip"
    local ios_zip="$OUTPUT_DIR/ios/libgodot-ios.xcframework.zip"
    local repository tag asset sdk_sha custom_godot_commit godot_commit
    local mac_sha ios_sha provenance_tmp

    if [[ ! -d "$OUTPUT_DIR/mac/libgodot.xcframework" || ! -d "$OUTPUT_DIR/ios/libgodot.xcframework" ]]; then
        echo "error: cannot create zips until both xcframeworks exist" >&2
        exit 1
    fi

    echo "Creating SwiftPM payload zips..."
    scripts/create-deterministic-zip "$OUTPUT_DIR/mac/libgodot.xcframework" "$mac_zip"
    scripts/create-deterministic-zip "$OUTPUT_DIR/ios/libgodot.xcframework" "$ios_zip"

    if [[ "$INPUT_KIND" == "sdk" ]]; then
        repository=$(jq -er '.repository' "$SDK_LOCK")
        tag=$(jq -er '.tag' "$SDK_LOCK")
        asset=$(jq -er '.asset' "$SDK_LOCK")
        sdk_sha=$(jq -er '.sha256' "$SDK_LOCK")
        custom_godot_commit=$(jq -er '.customGodotCommit' "$SDK_LOCK")
        godot_commit=$(jq -er '.godotCommit' "$SDK_LOCK")
        mac_sha=$(swift package compute-checksum "$mac_zip")
        ios_sha=$(swift package compute-checksum "$ios_zip")
        provenance_tmp=$(mktemp "$OUTPUT_DIR/.libgodot-payload-provenance.XXXXXX")
        jq -n \
            --arg repository "$repository" \
            --arg tag "$tag" \
            --arg asset "$asset" \
            --arg sdkSha256 "$sdk_sha" \
            --arg customGodotCommit "$custom_godot_commit" \
            --arg godotCommit "$godot_commit" \
            --arg macSha256 "$mac_sha" \
            --arg iosSha256 "$ios_sha" \
            '{schemaVersion:1,inputKind:"locked-sdk",repository:$repository,tag:$tag,asset:$asset,sdkSha256:$sdkSha256,customGodotCommit:$customGodotCommit,godotCommit:$godotCommit,macSha256:$macSha256,iosSha256:$iosSha256}' \
            > "$provenance_tmp"
        chmod 644 "$provenance_tmp"
        mv "$provenance_tmp" "$OUTPUT_DIR/libgodot-payload-provenance.json"
    else
        rm -f "$OUTPUT_DIR/libgodot-payload-provenance.json"
    fi

    echo ""
    echo "SwiftPM checksums:"
    echo "macOS $(swift package compute-checksum "$mac_zip")"
    echo "iOS   $(swift package compute-checksum "$ios_zip")"
    echo ""
    echo "Payloads:"
    echo "  $mac_zip"
    echo "  $ios_zip"
}

if [[ "$BUILD_ARTIFACTS" == "1" ]]; then
    build_godot_artifacts
fi

mkdir -p "$OUTPUT_DIR/mac" "$OUTPUT_DIR/ios"

PACKAGING_TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$PACKAGING_TMP_DIR"' EXIT

select_artifacts

echo "Packaging macOS libgodot..."
if [[ -f "$MAC_ARM_LIB" && -f "$MAC_X86_LIB" ]]; then
    verify_macos_dylib "$MAC_ARM_LIB" arm64
    verify_macos_dylib "$MAC_X86_LIB" x86_64
    MAC_ARM_TMP="$PACKAGING_TMP_DIR/libgodot-arm64.dylib"
    MAC_X86_TMP="$PACKAGING_TMP_DIR/libgodot-x86_64.dylib"
    cp "$MAC_ARM_LIB" "$MAC_ARM_TMP"
    cp "$MAC_X86_LIB" "$MAC_X86_TMP"
    install_name_tool -id @rpath/libgodotkit.dylib "$MAC_ARM_TMP"
    install_name_tool -id @rpath/libgodotkit.dylib "$MAC_X86_TMP"
    UNIVERSAL_LIB="$PACKAGING_TMP_DIR/libgodotkit.dylib"
    lipo -create -output "$UNIVERSAL_LIB" "$MAC_ARM_TMP" "$MAC_X86_TMP"
    MAC_FRAMEWORK="$PACKAGING_TMP_DIR/libgodot-macos.xcframework"
    xcodebuild -create-xcframework \
        -library "$UNIVERSAL_LIB" \
        -output "$MAC_FRAMEWORK"
    verify_headerless_xcframework "$MAC_FRAMEWORK"
    replace_framework "$MAC_FRAMEWORK" "$OUTPUT_DIR/mac/libgodot.xcframework"
else
    cat <<EOF
Missing macOS libgodot dylibs.
Build them first with:
    cd $GODOT_DIR
    scons platform=macos arch=arm64 target=template_$CONFIGURATION library_type=shared_library vulkan=no metal=yes disable_path_overrides=no
    scons platform=macos arch=x86_64 target=template_$CONFIGURATION library_type=shared_library vulkan=no metal=yes disable_path_overrides=no
EOF
    exit 1
fi

echo "Packaging iOS libgodot..."
if [[ -f "$IOS_DEVICE_LIB" ]]; then
    verify_embeddable_ios_archive "$IOS_DEVICE_LIB" arm64
    if [[ -f "$IOS_SIM_ARM_LIB" ]]; then
        verify_embeddable_ios_archive "$IOS_SIM_ARM_LIB" arm64
    fi
    if [[ -f "$IOS_SIM_X86_LIB" ]]; then
        verify_embeddable_ios_archive "$IOS_SIM_X86_LIB" x86_64
    fi
    if [[ ! -f "$IOS_SIM_ARM_LIB" && ! -f "$IOS_SIM_X86_LIB" ]]; then
        echo "error: an iOS Simulator libgodot slice is required" >&2
        exit 1
    fi

    IOS_DEVICE_DIR="$PACKAGING_TMP_DIR/ios-device"
    IOS_SIM_DIR="$PACKAGING_TMP_DIR/ios-simulator"
    mkdir -p "$IOS_DEVICE_DIR" "$IOS_SIM_DIR"

    IOS_DEVICE_TMP="$IOS_DEVICE_DIR/libgodotkit.a"
    cp "$IOS_DEVICE_LIB" "$IOS_DEVICE_TMP"

    IOS_SIM_TMP=""
    if [[ -f "$IOS_SIM_ARM_LIB" && -f "$IOS_SIM_X86_LIB" ]]; then
        IOS_SIM_TMP="$IOS_SIM_DIR/libgodotkit.a"
        lipo -create -output "$IOS_SIM_TMP" "$IOS_SIM_ARM_LIB" "$IOS_SIM_X86_LIB"
        verify_exact_architectures "$IOS_SIM_TMP" arm64 x86_64
    elif [[ -f "$IOS_SIM_ARM_LIB" ]]; then
        IOS_SIM_TMP="$IOS_SIM_DIR/libgodotkit.a"
        cp "$IOS_SIM_ARM_LIB" "$IOS_SIM_TMP"
    elif [[ -f "$IOS_SIM_X86_LIB" ]]; then
        IOS_SIM_TMP="$IOS_SIM_DIR/libgodotkit.a"
        cp "$IOS_SIM_X86_LIB" "$IOS_SIM_TMP"
    fi

    IOS_FRAMEWORK="$PACKAGING_TMP_DIR/libgodot-ios.xcframework"
    if [[ -n "$IOS_SIM_TMP" ]]; then
        xcodebuild -create-xcframework \
            -library "$IOS_DEVICE_TMP" \
            -library "$IOS_SIM_TMP" \
            -output "$IOS_FRAMEWORK"
    else
        xcodebuild -create-xcframework \
            -library "$IOS_DEVICE_TMP" \
            -output "$IOS_FRAMEWORK"
    fi
    verify_headerless_xcframework "$IOS_FRAMEWORK"
    replace_framework "$IOS_FRAMEWORK" "$OUTPUT_DIR/ios/libgodot.xcframework"
else
    cat <<EOF
Missing iOS libgodot static libraries.
Build them first with:
    cd $GODOT_DIR
    scons platform=ios arch=arm64 ios_simulator=no target=template_$CONFIGURATION library_type=static_library vulkan=no metal=yes disable_path_overrides=no
    scons platform=ios arch=arm64 ios_simulator=yes target=template_$CONFIGURATION library_type=static_library vulkan=no metal=yes disable_path_overrides=no
EOF
    exit 1
fi

if [[ "$CREATE_ZIPS" == "1" ]]; then
    zip_payloads
fi

echo "Done. Local frameworks are available under $OUTPUT_DIR."
