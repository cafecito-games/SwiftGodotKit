#!/usr/bin/env python3
"""Create a byte-reproducible ZIP containing one directory tree."""

from __future__ import annotations

import os
from pathlib import Path
import shutil
import stat
import sys
import tempfile
import zipfile


FIXED_TIMESTAMP = (1980, 1, 1, 0, 0, 0)


def fail(message: str) -> "NoReturn":
    raise SystemExit(f"error: {message}")


def archive_info(path: Path, archive_name: str) -> zipfile.ZipInfo:
    info = zipfile.ZipInfo(archive_name, FIXED_TIMESTAMP)
    info.create_system = 3
    info.compress_type = zipfile.ZIP_DEFLATED
    if path.is_dir():
        mode = stat.S_IFDIR | 0o755
    else:
        executable = bool(path.stat().st_mode & 0o111)
        mode = stat.S_IFREG | (0o755 if executable else 0o644)
    info.external_attr = mode << 16
    return info


def main() -> None:
    if len(sys.argv) != 3:
        fail("usage: create-deterministic-zip DIRECTORY OUTPUT_ZIP")

    source = Path(sys.argv[1]).resolve()
    output = Path(sys.argv[2]).resolve()
    if not source.is_dir():
        fail(f"source is not a directory: {source}")
    if any(path.is_symlink() for path in source.rglob("*")):
        fail("source contains symbolic links")

    output.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{output.name}.", dir=output.parent)
    os.close(descriptor)
    try:
        with zipfile.ZipFile(temporary_name, "w", allowZip64=True, compresslevel=9) as archive:
            root_name = f"{source.name}/"
            root_info = zipfile.ZipInfo(root_name, FIXED_TIMESTAMP)
            root_info.create_system = 3
            root_info.compress_type = zipfile.ZIP_STORED
            root_info.external_attr = (stat.S_IFDIR | 0o755) << 16
            archive.writestr(root_info, b"")

            for path in sorted(source.rglob("*"), key=lambda item: item.relative_to(source).as_posix()):
                relative = path.relative_to(source).as_posix()
                archive_name = f"{source.name}/{relative}"
                if path.is_dir():
                    if not archive_name.endswith("/"):
                        archive_name += "/"
                    archive.writestr(archive_info(path, archive_name), b"")
                elif path.is_file():
                    info = archive_info(path, archive_name)
                    with path.open("rb") as input_file, archive.open(info, "w") as output_file:
                        shutil.copyfileobj(input_file, output_file, length=1024 * 1024)
                else:
                    fail(f"unsupported filesystem entry: {path}")
        os.replace(temporary_name, output)
    except BaseException:
        try:
            os.unlink(temporary_name)
        except FileNotFoundError:
            pass
        raise


if __name__ == "__main__":
    main()
