#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 2 ]]; then
    echo "usage: verify-custom-godot-sdk SDK_DIR LOCK_FILE" >&2
    exit 2
fi

sdk_dir=$(cd "$1" && pwd)
lock_file=$(cd "$(dirname "$2")" && pwd)/$(basename "$2")
manifest="$sdk_dir/BUILD_INFO.json"

fail() {
    echo "error: $*" >&2
    exit 1
}

[[ -f "$manifest" ]] || fail "missing SDK manifest: $manifest"
[[ -f "$lock_file" ]] || fail "missing SDK lock: $lock_file"
jq -e 'type == "object"' "$manifest" >/dev/null || fail "SDK manifest is not a JSON object"
jq -e 'type == "object"' "$lock_file" >/dev/null || fail "SDK lock is not a JSON object"

expected_custom_commit=$(jq -er '.customGodotCommit | select(test("^[0-9a-f]{40}$"))' "$lock_file") || fail "lock has no full custom-Godot commit"
expected_godot_commit=$(jq -er '.godotCommit | select(test("^[0-9a-f]{40}$"))' "$lock_file") || fail "lock has no full Godot commit"
expected_version=$(jq -er '.godotVersion | select(type == "string" and length > 0)' "$lock_file") || fail "lock has no Godot version"
actual_custom_commit=$(jq -er '.custom_godot_commit | select(test("^[0-9a-f]{7,40}$"))' "$manifest") || fail "manifest has no custom-Godot commit"
actual_godot_commit=$(jq -er '.godot_commit | select(test("^[0-9a-f]{7,40}$"))' "$manifest") || fail "manifest has no Godot commit"
actual_version=$(jq -er '.godot_version | select(type == "string" and length > 0)' "$manifest") || fail "manifest has no Godot version"

[[ "$expected_custom_commit" == "$actual_custom_commit"* ]] || fail "custom-Godot commit mismatch: expected $expected_custom_commit, got $actual_custom_commit"
[[ "$expected_godot_commit" == "$actual_godot_commit"* ]] || fail "Godot commit mismatch: expected $expected_godot_commit, got $actual_godot_commit"
[[ "$actual_version" == "$expected_version" ]] || fail "Godot version mismatch: expected $expected_version, got $actual_version"

required_files=(
    COPYRIGHT.txt
    LICENSE.txt
    bin/libgodot.ios.template_release.arm64.a
    bin/libgodot.ios.template_release.arm64.simulator.a
    bin/libgodot.macos.template_release.arm64.dylib
    bin/libgodot.macos.template_release.x86_64.dylib
    extension_api.json
    include/gdextension_interface.gen.h
    include/libgodot.h
)

for relative_path in "${required_files[@]}"; do
    [[ -f "$sdk_dir/$relative_path" ]] || fail "missing SDK file: $relative_path"
    recorded_checksum=$(jq -er --arg path "$relative_path" '.files[$path] | select(test("^[0-9a-f]{64}$"))' "$manifest") || fail "missing checksum for $relative_path"
    actual_checksum=$(shasum -a 256 "$sdk_dir/$relative_path" | awk '{print $1}')
    [[ "$actual_checksum" == "$recorded_checksum" ]] || fail "checksum mismatch for $relative_path"
done

recorded_files=$(jq -er '.files | keys[]' "$manifest" | sort)
actual_files=$(find "$sdk_dir" -type f ! -name BUILD_INFO.json -print | sed "s#^$sdk_dir/##" | sort)
[[ "$recorded_files" == "$actual_files" ]] || fail "SDK files differ from BUILD_INFO.json"

if find "$sdk_dir" -type l -print -quit | grep -q .; then
    fail "SDK must not contain symbolic links"
fi

printf 'Custom Godot SDK: %s (%s)\n' "$actual_custom_commit" "$expected_custom_commit"
printf 'Godot:           %s (%s)\n' "$actual_godot_commit" "$actual_version"
file_count=$(printf '%s\n' "$actual_files" | awk 'NF { count++ } END { print count + 0 }')
printf 'Integrity:       %s files verified\n' "$file_count"
