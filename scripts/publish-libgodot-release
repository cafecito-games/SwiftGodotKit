#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 7 ]]; then
    echo "usage: publish-libgodot-release TAG SDK_DIR SDK_LOCK OUTPUT_DIR PACKAGE_FILE RELEASE_REPO GODOT_REPO" >&2
    exit 2
fi

tag=$1
sdk_dir=$(cd "$2" && pwd)
sdk_lock=$(cd "$(dirname "$3")" && pwd)/$(basename "$3")
output_dir=$(cd "$4" && pwd)
package_file=$5
release_repo=$6
godot_repo=$7

if [[ ! $tag =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo "Invalid release tag: $tag" >&2
    exit 2
fi

mac_zip="$output_dir/mac/libgodot-macos.xcframework.zip"
ios_zip="$output_dir/ios/libgodot-ios.xcframework.zip"
for file in "$mac_zip" "$ios_zip" "$package_file"; do
    if [[ ! -f $file ]]; then
        echo "Missing release input: $file" >&2
        exit 1
    fi
done

scripts/verify-custom-godot-sdk "$sdk_dir" "$sdk_lock"
godot_sha=$(jq -er '.godotCommit' "$sdk_lock")
custom_godot_sha=$(jq -er '.customGodotCommit' "$sdk_lock")
custom_godot_tag=$(jq -er '.tag' "$sdk_lock")
custom_godot_asset=$(jq -er '.asset' "$sdk_lock")
custom_godot_asset_sha=$(jq -er '.sha256' "$sdk_lock")
gh api "repos/$godot_repo/commits/$custom_godot_sha" --jq .sha >/dev/null
mac_checksum=$(swift package compute-checksum "$mac_zip")
ios_checksum=$(swift package compute-checksum "$ios_zip")
mac_url="https://github.com/$release_repo/releases/download/$tag/libgodot-macos.xcframework.zip"
ios_url="https://github.com/$release_repo/releases/download/$tag/libgodot-ios.xcframework.zip"

echo "Godot commit: $godot_sha"
echo "Custom Godot commit: $custom_godot_sha"
echo "Custom Godot release: $custom_godot_tag/$custom_godot_asset ($custom_godot_asset_sha)"
echo "macOS checksum: $mac_checksum"
echo "iOS checksum: $ios_checksum"

manifest_candidate=$(mktemp)
temporary_notes=""
release_created=0
cleanup() {
    exit_code=$?
    trap - EXIT
    if [[ $exit_code -ne 0 && $release_created == 1 ]]; then
        gh release delete "$tag" --repo "$release_repo" --cleanup-tag --yes || true
    fi
    rm -f "$manifest_candidate"
    if [[ -n $temporary_notes ]]; then
        rm -f "$temporary_notes"
    fi
    exit "$exit_code"
}
trap cleanup EXIT

python3 - "$package_file" "$manifest_candidate" "$mac_url" "$mac_checksum" "$ios_url" "$ios_checksum" <<'PY'
from pathlib import Path
import re
import sys

source = Path(sys.argv[1]).read_text()
targets = (
    ("macLibgodotTarget", "mac_libgodot", sys.argv[3], sys.argv[4]),
    ("iosLibgodotTarget", "ios_libgodot", sys.argv[5], sys.argv[6]),
)
for variable, name, url, checksum in targets:
    pattern = re.compile(
        rf'(let {variable}: Target = \.binaryTarget\(\s*name: "{name}",\s*)'
        r'(?:path: "[^"]+"|url: "[^"]+",\s*checksum: "[^"]+")'
    )
    source, count = pattern.subn(
        lambda match: match.group(1) + f'url: "{url}",\n    checksum: "{checksum}"',
        source,
    )
    if count != 1:
        raise SystemExit(f"Expected one {name} binary target, found {count}")
Path(sys.argv[2]).write_text(source)
PY

if [[ ${PUBLISH_DRY_RUN:-0} == 1 ]]; then
    echo "Dry run: would create $tag in $release_repo and update $package_file"
    diff -u "$package_file" "$manifest_candidate" || true
    exit 0
fi

if gh release view "$tag" --repo "$release_repo" >/dev/null 2>&1 ||
    git ls-remote --exit-code --tags "https://github.com/$release_repo.git" "refs/tags/$tag" >/dev/null 2>&1; then
    echo "Release or tag already exists: $release_repo@$tag" >&2
    exit 1
fi

notes_file=${RELEASE_NOTES_FILE:-}
if [[ -z $notes_file ]]; then
    temporary_notes=$(mktemp)
    notes_file=$temporary_notes
    cat > "$notes_file" <<EOF
SwiftGodotKit Apple libgodot payloads built from Godot commit $godot_sha.
Custom Godot source: https://github.com/$godot_repo/commit/$custom_godot_sha
Custom Godot SDK: https://github.com/$godot_repo/releases/tag/$custom_godot_tag
Source SDK asset SHA-256: $custom_godot_asset_sha

- macOS arm64 and x86_64 XCFramework (SHA-256: $mac_checksum)
- iOS arm64 device and simulator XCFramework (SHA-256: $ios_checksum)
EOF
elif [[ ! -f $notes_file ]]; then
    echo "Missing release notes: $notes_file" >&2
    exit 1
fi

release_flags=()
if [[ ${RELEASE_PRERELEASE:-0} == 1 ]]; then
    release_flags+=(--prerelease)
fi

release_created=1
gh release create "$tag" "$mac_zip" "$ios_zip" \
    --repo "$release_repo" \
    --title "$tag" \
    --notes-file "$notes_file" \
    "${release_flags[@]}"

published_mac_digest=$(gh release view "$tag" --repo "$release_repo" --json assets --jq '.assets[] | select(.name == "libgodot-macos.xcframework.zip") | .digest')
published_ios_digest=$(gh release view "$tag" --repo "$release_repo" --json assets --jq '.assets[] | select(.name == "libgodot-ios.xcframework.zip") | .digest')
[[ "$published_mac_digest" == "sha256:$mac_checksum" ]] || {
    echo "Published macOS digest mismatch: $published_mac_digest" >&2
    exit 1
}
[[ "$published_ios_digest" == "sha256:$ios_checksum" ]] || {
    echo "Published iOS digest mismatch: $published_ios_digest" >&2
    exit 1
}

cat "$manifest_candidate" > "$package_file"
release_created=0

echo "Updated $package_file with the published URLs and checksums."
